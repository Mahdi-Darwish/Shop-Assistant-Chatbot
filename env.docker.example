# Local Docker development only. Never commit .env.docker itself.
POSTGRES_USER=admin
POSTGRES_PASSWORD=choose-a-real-local-password
POSTGRES_DB=shopassistant_db

DATABASE_URL=postgresql+psycopg2://admin:choose-a-real-local-password@db:5432/shopassistant_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-long-random-secret-never-commit-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GROQ_API_KEY=your-groq-api-key

# Development keeps local/file:// UI access working.
ENVIRONMENT=development
