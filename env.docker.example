# Copy this file to .env.docker and fill in REAL values — never commit
# .env.docker itself (it's gitignored on purpose).
# Note: DATABASE_URL and REDIS_URL use the Docker SERVICE NAMES (db,
# redis) from docker-compose.yaml, not "localhost".
POSTGRES_USER=admin
POSTGRES_PASSWORD=choose-a-real-password-here
POSTGRES_DB=shopassistant_db

DATABASE_URL=postgresql+psycopg2://admin:choose-a-real-password-here@db:5432/shopassistant_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-long-random-secret-never-commit-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GROQ_API_KEY=your-groq-api-key
